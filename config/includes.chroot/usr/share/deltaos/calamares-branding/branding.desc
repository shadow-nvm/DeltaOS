---
# DeltaOS installer branding.
#
# Structure follows Debian's shipped calamares-settings-debian branding.desc
# step for step: the strings, images, style and slideshow groups are the ones
# Calamares 3.3 actually loads, and a missing group aborts the installer.
# build/build-iso.sh replaces the version fields from the VERSION file.
componentName: deltaos
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 800px,580px
windowPlacement: center

strings:
    productName: DeltaOS
    shortProductName: DeltaOS
    version: 0.2.0
    shortVersion: 0.2.0
    versionedName: DeltaOS 0.2.0 Aurora
    shortVersionedName: DeltaOS 0.2.0
    bootloaderEntryName: DeltaOS
    releaseNotesTitle: DeltaOS Aurora
    knownIssuesTitle: Project status

sidebar: widget
navigation: widget

images:
    productLogo: "deltaos-logo.png"
    productIcon: "deltaos-logo.png"
    productWelcome: "deltaos-welcome.png"

slideshow: "show.qml"

style:
    SidebarBackground: "#0b1026"
    SidebarText: "#eef2ff"
    SidebarTextCurrent: "#ffffff"
    SidebarBackgroundCurrent: "#1c2a55"

slideshowAPI: 2
