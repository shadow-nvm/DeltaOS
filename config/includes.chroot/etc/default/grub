# DeltaOS boot defaults for the installed system.
#
# Calamares regenerates /boot/grub/grub.cfg with grub-mkconfig after unpacking
# the image, so these values become the installed system's boot menu. The live
# medium's own GRUB menu is generated by live-build from the ISO tree and is
# not affected by this file.
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="DeltaOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""

# Let GRUB find a Windows or second Linux installation when the user asked for
# a dual boot. Debian disables this by default; DeltaOS enables it because the
# installer offers "install alongside" as a normal choice.
GRUB_DISABLE_OS_PROBER=false

# Prefer a wide graphical menu, falling back to whatever the firmware offers.
GRUB_GFXMODE=1280x720,1024x768,auto
GRUB_GFXPAYLOAD_LINUX=keep
