#!/bin/bash
# Register the live desktop, the installer entry, and the DeltaHub first-run
# screen. Everything written here lands in the squashfs, which Calamares
# unpacks for the installed system; runtime-only files are created by systemd
# units that check for the live medium.
set -e

echo "==> DeltaOS: configuring the desktop session"

enable() {
    systemctl enable "$1" >/dev/null 2>&1 || true
}

enable sddm
enable NetworkManager
enable systemd-timesyncd
enable power-profiles-daemon
enable upower
enable bluetooth

# ---------------------------------------------------------------------------
# Live session: automatic login as the "live" user, and the installer entry
# that only exists while booted from the live medium.
mkdir -p /usr/share/deltaos /usr/lib/systemd/system
cat > /usr/share/deltaos/sddm-live.conf <<'EOF'
[Autologin]
User=live
Session=plasma.desktop
EOF

cat > /usr/lib/systemd/system/deltaos-live-autologin.service <<'EOF'
[Unit]
Description=Set up automatic login for the DeltaOS live session
ConditionPathExists=/run/live/medium
After=local-fs.target live-config.service
Before=sddm.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/bin/install -D -m 0644 /usr/share/deltaos/sddm-live.conf /etc/sddm.conf.d/60-deltaos-live.conf && /usr/bin/install -D -m 0644 /usr/share/deltaos/deltaos-install.desktop /usr/share/applications/deltaos-install.desktop'
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
EOF
enable deltaos-live-autologin.service

# The installer menu entry ships at /usr/share/deltaos/deltaos-install.desktop
# and is copied into /usr/share/applications by the live unit above, so an
# installed system never shows an "Install DeltaOS" launcher. Its Exec target,
# /usr/bin/deltaos-install, moves the live-build /etc/fstab out of the way and
# grants the root installer access to the display, exactly like Debian's own
# live installer wrapper.
if [ -x /usr/bin/deltaos-install ]; then
    chmod 0755 /usr/bin/deltaos-install /usr/bin/deltaos-layout 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# The live system does not need /etc/fstab: live-boot and systemd mount
# everything the session needs. Leaving the file behind makes Calamares show
# the running live system's mounts as installation targets. Debian's own live
# installer moves the file out of the way at launch; DeltaOS removes it from the
# image and /usr/bin/deltaos-install still moves it aside if it reappears.
rm -f /etc/fstab

# calamares-settings-debian ships its own launcher and an autostart entry that
# puts an "Install Debian" icon on the desktop of every session. DeltaOS
# replaces both with its own live-only entry, so the Debian ones must go or the
# live desktop advertises the wrong operating system.
rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop
rm -f /usr/share/applications/calamares-install-debian.desktop
rm -f /usr/share/applications/calamares-install-debian.desktop.bak

# ---------------------------------------------------------------------------
# SDDM: pick a theme that actually exists in this image. Without an explicit
# theme, a greeter with no theme installed shows no login screen at all.
THEME=""
for candidate in breeze debian-breeze debian-maui; do
    if [ -d "/usr/share/sddm/themes/${candidate}" ]; then
        THEME="${candidate}"
        break
    fi
done
if [ -z "${THEME}" ]; then
    THEME="$(find /usr/share/sddm/themes -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | head -n 1 || true)"
fi
mkdir -p /etc/sddm.conf.d
{
    echo "[General]"
    echo "Numlock=on"
    if [ -n "${THEME}" ]; then
        echo
        echo "[Theme]"
        echo "Current=${THEME}"
    fi
} > /etc/sddm.conf.d/10-deltaos.conf
echo "    SDDM theme: ${THEME:-none found}"

# ---------------------------------------------------------------------------
# Identity. Keep the Debian-compatible keys so packaging tools stay happy.
DELTA_VERSION="$(sed -n 's/^VERSION=//p' /etc/deltaos/release 2>/dev/null | head -n 1)"
if [ -z "${DELTA_VERSION}" ]; then
    DELTA_VERSION="$(sed -n 's/^VERSION=//p' /usr/share/deltaos/release 2>/dev/null | head -n 1)"
fi
DELTA_VERSION="${DELTA_VERSION:-0.2.0}"
cat > /etc/os-release <<EOF
NAME="DeltaOS"
PRETTY_NAME="DeltaOS Aurora ${DELTA_VERSION}"
ID=deltaos
ID_LIKE=debian
VERSION_ID="${DELTA_VERSION}"
VERSION_CODENAME=trixie
ANSI_COLOR="0;36"
EOF

# The installed system inherits these files from the squashfs: without them a
# freshly installed DeltaOS would call itself "debian" and show Debian's text
# console banner. The live session is unaffected (live-config sets the hostname
# from the kernel command line on every boot).
echo deltaos > /etc/hostname
if grep -q '^127\.0\.1\.1' /etc/hosts 2>/dev/null; then
    sed -i 's/^127\.0\.1\.1.*/127.0.1.1\tdeltaos/' /etc/hosts
else
    printf '127.0.1.1\tdeltaos\n' >> /etc/hosts
fi
{
    echo "DeltaOS Aurora ${DELTA_VERSION} \\n \\l"
    echo
} > /etc/issue
cp /etc/issue /etc/issue.net

# Wallpaper package, so the DeltaOS wallpapers also appear in System Settings.
WALLPAPER_DIR=/usr/share/wallpapers/DeltaOS/contents/images
mkdir -p "${WALLPAPER_DIR}"
if [ -f /usr/share/deltaos/artwork/wallpaper-dark.jpg ]; then
    cp -f /usr/share/deltaos/artwork/wallpaper-dark.jpg "${WALLPAPER_DIR}/3840x2160.jpg"
fi
if [ -f /usr/share/deltaos/artwork/wallpaper-aurora.jpg ]; then
    mkdir -p /usr/share/wallpapers/DeltaOS-aurora/contents/images
    cp -f /usr/share/deltaos/artwork/wallpaper-aurora.jpg \
        /usr/share/wallpapers/DeltaOS-aurora/contents/images/2560x1440.jpg
fi

# ---------------------------------------------------------------------------
# Calamares branding lives where the installer looks for it.
if [ -d /usr/share/deltaos/calamares-branding ]; then
    mkdir -p /etc/calamares/branding/deltaos
    cp -a /usr/share/deltaos/calamares-branding/. /etc/calamares/branding/deltaos/
fi

# One first-run entry per new account keeps a single welcome window. The same
# flow exposes the installer only during a live boot.
if [ -f /usr/bin/deltahub ]; then
    chmod 0755 /usr/bin/deltahub
    mkdir -p /etc/skel/.config/autostart
    cat > /etc/skel/.config/autostart/deltaos-firstlogin.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=DeltaOS First Run
Comment=Welcome to DeltaOS
Exec=/usr/bin/deltahub --first-run
Icon=deltaos
Terminal=false
OnlyShowIn=KDE;
X-GNOME-Autostart-enabled=true
EOF
fi

# ---------------------------------------------------------------------------
# Boot splash and desktop caches.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme deltaos -R || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi

echo "==> DeltaOS: desktop is configured"
