# DeltaOS base system -- everything here MUST exist in Debian 13 trixie.
# Installed before the desktop; keep this list lean, the ISO stays small.
live-boot
live-config
live-config-systemd
# Creates the automatic "live" account for the live session; without it the
# desktop has nobody to log in as.
user-setup
squashfs-tools
file
less
nano
vim-tiny
sudo
locales
tzdata
keyboard-configuration
console-setup
ca-certificates
curl
wget
gnupg
xz-utils
zstd
unzip
zip
pciutils
usbutils
lshw
htop
rsync
parted
gparted
dosfstools
mtools
# Used by deltaos-persistence to create the live persistence volume.
# util-linux (sfdisk, mount) is essential and always present.
e2fsprogs
python3
efibootmgr
os-prober
# Bootloader tooling. live-build's binary stage checks for these in the chroot
# and would otherwise try to apt-install them after the chroot is finished;
# a build must not depend on that late network step.
grub-common
grub2-common
grub-efi-amd64-bin
grub-pc-bin
# Signed GRUB + shim make the ISO bootable with UEFI Secure Boot enabled and
# let the installer register a Secure Boot capable bootloader on the target.
grub-efi-amd64-signed
shim-signed
# live-build's iso-hybrid step needs the El Torito/isohybrid binaries from
# isolinux and xorriso inside the chroot.
isolinux
xorriso
# live-build uses dctrl-tools to build the binary package index and
# librsvg2-bin to render the boot splash; both are checked in the chroot.
dctrl-tools
librsvg2-bin
initramfs-tools
network-manager
wpasupplicant
rfkill
bluez
pipewire
wireplumber
pipewire-pulse
pipewire-alsa
alsa-utils
pavucontrol-qt
fonts-inter
fonts-noto-core
fonts-noto-color-emoji
fonts-jetbrains-mono
fonts-dejavu-core
papirus-icon-theme
breeze
breeze-gtk-theme
libqt6svg6
qt6-wayland
xdg-utils
xdg-desktop-portal
xdg-desktop-portal-kde
systemd-oomd
zram-tools
power-profiles-daemon
upower
plymouth
plymouth-themes
dbus-user-session
# Hardware support: firmwares for common Wi-Fi, GPU and audio chips plus CPU
# microcode. Without these a laptop may boot with no wireless at all, so they
# are part of the base image rather than an add-on.
firmware-linux-free
firmware-iwlwifi
firmware-atheros
firmware-realtek
firmware-brcm80211
firmware-mediatek
firmware-sof-signed
firmware-amd-graphics
firmware-misc-nonfree
intel-microcode
amd64-microcode
# Nice-to-have command line polish
?fastfetch
?btop
?tmux
?tree
?fzf
?ripgrep
?fd-find
?zoxide
?git
?openssh-client
?python3-pyqt6.qtsvg
?modemmanager
