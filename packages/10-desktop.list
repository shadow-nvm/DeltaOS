# DeltaOS desktop -- KDE Plasma 6 on Wayland.
# Plasma provides a familiar, configurable desktop with a modern Wayland
# session and X11 fallback for older hardware and virtual machines.
plasma-desktop
plasma-workspace
plasma-nm
plasma-pa
plasma-systemmonitor
plasma-discover
systemsettings
kscreen
kwin-wayland
kwin-x11
sddm
# A theme must be installed explicitly: with --apt-recommends false nothing
# else pulls one, and sddm without a theme shows no login screen.
sddm-theme-breeze
python3-pyqt6
pkexec
polkit-kde-agent-1
xserver-xorg
# The X11 session needs an input driver; with --apt-recommends false nothing
# else pulls it, and an X server without libinput has no keyboard or mouse.
xserver-xorg-input-libinput
kde-config-gtk-style
kde-config-screenlocker
kde-style-breeze
kde-spectacle
breeze-cursor-theme
powerdevil
dolphin
konsole
kate
ark
okular
gwenview
kcalc
filelight
partitionmanager
kinfocenter
kmenuedit
# Optional extras: present in trixie today, dropped automatically if renamed.
?plasma-widgets-addons
?kde-cli-tools
?kwin-addons
?qt6-image-formats-plugins
?xdg-desktop-portal-gtk
?kde-config-plymouth
?kde-config-cron
?plasma-discover-backend-flatpak
?kdeconnect
?ksystemlog
?libpam-kwallet5
?libpam-kwallet-common
?kwalletmanager
?bluedevil
?kde-config-sddm
?xserver-xorg-video-vmware
?xserver-xorg-video-vesa
?print-manager
?kio-extras
?ffmpegthumbs
?kdegraphics-thumbnailers
?plasma-workspace-wallpapers
